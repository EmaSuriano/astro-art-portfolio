---
import '../styles/global.css';
import { SEO_INFO } from '../consts';
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';

type Props = { title: string };

const forceTheme = import.meta.env.FORCE_THEME || '';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class={forceTheme || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {SEO_INFO.map((tag) => <meta name={tag.name} content={tag.content} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-slate-50 dark:bg-slate-800">
    <div class="flex min-h-screen flex-col py-4 sm:py-6 lg:py-8">
      <main class="mb-auto flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import '../load-gallery.js';
    </script>
  </body>
</html>
