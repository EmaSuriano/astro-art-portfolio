---
import probe from 'probe-image-size';
import Layout from '../layouts/Layout.astro';
import { PERSONAL_INFO } from '../consts';
import { getNotionItems } from '../utils';

const notionItems = await getNotionItems({
  auth: import.meta.env.NOTION_API_KEY,
});

const images = await Promise.all(
  notionItems.reverse().map(async ({ label, href }) => {
    const size = await probe(href).catch(() => ({
      width: 800,
      height: 1200,
    }));

    return { label, href, size };
  }),
);
---

<Layout title={PERSONAL_INFO.title}>
  <div class="my-8 sm:my-12">
    <h1
      class="font-display mb-4 text-center text-display text-ink md:mb-6"
    >
      {PERSONAL_INFO.name}
    </h1>

    <p
      class="mx-auto max-w-screen-md text-center text-muted md:text-lg"
    >
      {PERSONAL_INFO.subtitle}
    </p>
  </div>

  <div class="mx-auto max-w-screen-xl px-4 md:px-8">
    <div
      id="my-gallery"
      class="pswp-gallery gallery columns-2 gap-4 sm:columns-3 md:gap-6 lg:columns-4 xl:gap-8"
    >
      {
        images.map((image, index) => (
          <a
            href={image.href}
            data-cropped="false"
            data-pswp-width={image.size.width}
            data-pswp-height={image.size.height}
            class="gallery-item group mb-4 inline-block w-full break-inside-avoid overflow-hidden rounded-xl bg-paper-2 shadow-lg transition duration-200 hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus md:mb-6"
          >
            <span class="relative block">
              <img
                src={image.href}
                alt={image.label}
                width={image.size.width}
                height={image.size.height}
                class="block h-auto w-full"
                loading={index < 4 ? 'eager' : 'lazy'}
                fetchpriority={index < 2 ? 'high' : undefined}
                decoding="async"
              />

              <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/55 via-ink/15 to-transparent px-3 pb-3 pt-10">
                <span class="inline-block rounded-lg border border-rule/50 px-2 py-1 text-xs text-paper backdrop-blur-sm md:px-3 md:text-sm">
                  {image.label}
                </span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
